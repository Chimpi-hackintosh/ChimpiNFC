<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📲 ChimpiNFC"
            android:textSize="30sp"
            android:textColor="@color/ink"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Leia e grave etiquetas NFC comuns e consulte links públicos de AirTags"
            android:textColor="@color/muted"
            android:textSize="16sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:padding="18dp"
            android:orientation="vertical"
            android:background="@drawable/card">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GRAVADOR NFC"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/ink" />
            <RadioGroup
                android:id="@+id/recordType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/radioText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Texto" />
                <RadioButton
                    android:id="@+id/radioUrl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Link" />
            </RadioGroup>
            <EditText
                android:id="@+id/payloadInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="60dp"
                android:hint="Conteúdo para gravar"
                android:inputType="textMultiLine" />
            <Button
                android:id="@+id/armWriteButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="Preparar gravação"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:background="@drawable/button_primary" />
            <Button
                android:id="@+id/cancelWriteButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Cancelar gravação / Apenas ler"
                android:textAllCaps="false" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/muted"
                android:text="Gravar substitui os dados anteriores da etiqueta e exige confirmação" />
        </LinearLayout>
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Verificando NFC…"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="ÚLTIMA LEITURA"
            android:textColor="@color/ink"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/scanResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="92dp"
            android:padding="16dp"
            android:text="Aproxime uma etiqueta NFC ou um AirTag"
            android:textIsSelectable="true"
            android:textColor="@color/ink"
            android:background="@drawable/card" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="🍎 AirTag original: somente leitura NFC pública. Gerencie e localize seus AirTags pelo app Buscar da Apple"
            android:textColor="@color/muted"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
